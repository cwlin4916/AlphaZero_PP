######################################
# Heavy artifacts kept out of the repo
######################################
# external papers (not redistributed in-repo)
/papers/
/docs/papers/
# presentation build artifacts (PDFs/aux/etc.)
/docs/presentations/improvementv1/
# results-companion figures & run data (regenerable from driver scripts)
docs/notes/**/figures/
docs/notes/**/data/
# local Claude Code settings
.claude/

######################################
# Stage-4 results companions (small JSON/CSV summaries kept in git for reproducibility)
# — these re-includes come *after* the broad ignores above, so they win.
# Raw per-episode all.jsonl dumps live under results/ and stay ignored.
######################################
!docs/notes/stage4/data/
!docs/notes/stage4/data/**/
!docs/notes/stage4/data/**/*.json
!docs/notes/stage4/data/**/*.jsonl
!docs/notes/stage4/data/**/*.csv

######################################
# Misc
######################################
*.tmp
*.bak
